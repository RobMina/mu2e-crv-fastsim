{
  "name": "crvfastsim-venv",
  "executable": "/bin/bash",
  "arguments": ["${CRVFS_EAGLE}/hello/hello_gpu.sh"],
  "directory": "${CRVFS_EAGLE}/hello",
  "stdout_path": "${CRVFS_EAGLE}/hello/setup_venv.out",
  "stderr_path": "${CRVFS_EAGLE}/hello/setup_venv.err",
  "resources": {
    "node_count": 1
  },
  "attributes": {
    "duration": 1800,
    "queue_name": "debug",
    "account": "${ALCF_PROJECT}",
    "custom_attributes": {
      "filesystems": "home:eagle"
    }
  }
}
