# Site settings for the job scripts. Copy to site.env (git-ignored), fill in, and `source site.env` before running.
export CRVFS_CODE=/path/to/mu2e-crv-fastsim          # this repository on the Mu2e interactive machines
export CRVFS_DATA=/path/to/data/area/crv_fastsim       # outputs: tables, profiles, plots
export CRVFS_PNFS=/pnfs/mu2e/scratch/users/$USER/crv_fastsim   # grid outputs (dCache scratch)
export CRVFS_OWNER=$USER                               # owner field of Mu2e file names
export CRVFS_EAGLE=/eagle/<alcf-project>/$USER/crvfastsim      # ALCF work area (literal path: IRI does not expand variables)
export ALCF_PROJECT=<alcf-project>                     # ALCF allocation (job "account")
export IRI=/path/to/genesis-skills/skills/amsc-skills/iri-api  # AI-ModCon/genesis-skills iri-api skill
export IRI_PY=python3                                  # a python with globus-sdk (the iri-api skill's requirements)
export CRVFS_FCL_PATH=/path/to/fcl/dirs                # extra FHICL_FILE_PATH for art/dump_crvreco_ref.sh (data unpack fcl)
export CRVFS_SEARCH_PATH=/path/to/payload/root         # extra MU2E_SEARCH_PATH for the payloads that unpack fcl names
export CRVFS_STOCK_AREA=/path/to/built/muse/area      # Offline build with libmu2e_CRVReco.so, for crvfastsim.reco vr2stock
