# Site settings for the job scripts and the site-dependent Python tools. Copy to site.env (git-ignored) or keep it
# outside the repository, fill in your own values, and `source` it before running. Every value below is a placeholder:
# nothing in the repository supplies a site, user or storage path. A tool that needs a variable that is not set stops
# and names it (Python: mu2efastsim.site.SiteConfigError; shell: ${VAR:?...}).

# --- code and data on the Mu2e interactive machines
export CRVFS_CODE=/path/to/mu2e-crv-fastsim             # this repository
export M2FS_CODE=/path/to/mu2e-fastsim                  # the umbrella checkout (core/ and crv/), as seen by jobs
export M2FS_CORE=/path/to/mu2e-fastsim-core             # core checkout for drivers that pin one explicitly
export M2FS_DATA=/path/to/writable/data/area            # writable data area (outputs must lie under it)
export CRVFS_DATA=/path/to/approved/inputs/crv_fastsim  # CRV input tables (read-only inputs)
export CRVFS_OUT=/path/to/your/writable/crv-output      # pass explicitly as --outdir
export CRVFS_LOOKUP_DIR=$CRVFS_DATA/lookup_v6_0
# export CRVFS_OFFLINE_ROOT=/path/to/Offline/tree      # optional local Offline checkout searched before the CVMFS release
export MU2E_SEARCH_PATH=/path/to/approved/inputs/offline
export CRVVAL_AREA=/path/to/built/validation/muse/area  # stock-validation area (valhist/setup_crvval_area.sh)
export STEP_LAYERS_OUT=/path/to/step-layer/study        # step-layer closure study directory (scripts/run_step_*.sh)
# export CRVFS_RECORDED_DATA=/path/recorded/in/manifests  # data root recorded in old manifests (default CRVFS_DATA)
# export CRVFS_HOST_LOCKS=/path/to/host/locks             # per-host lock directory (valhist.generator_bank_campaign)

# --- dCache and the grid
export CRVFS_DCACHE=/path/to/dcache/mount               # mount point of the dCache namespace (holds <mount>/mu2e/...)
export CRVFS_XROOTD=root://xrootd.door.example//path/to/dcache/namespace   # xrootd prefix serving CRVFS_DCACHE
export CRVFS_PNFS=$CRVFS_DCACHE/mu2e/scratch/users/YOUR_GRID_USER/crv_fastsim   # this project's grid samples
export CRVFS_OWNER=YOUR_GRID_USER                       # owner field of Mu2e file names, grid job owner
# export VR4_BASE=$CRVFS_DCACHE/mu2e/scratch/users/YOUR_GRID_USER/crvfs_vr4   # grid/submit_vr4*.sh
# export VR5_BASE=$CRVFS_DCACHE/mu2e/scratch/users/YOUR_GRID_USER/vr5         # grid/submit_vr5_stock.sh, vr5_collect.sh
# export CRVONLY_V05_NTS=/path/to/crvonly_v05/nts                             # grid/vr5_collect.sh
# export FILELIST=/path/to/dts_filelist.txt MCR=/path/to/mu2e_track_crv_mcresponse   # grid/submit_vr5_stock.sh
# export FASTSIM_CPU_SIF=/path/to/mu2efastsim_cpu.sif                          # grid/submit_vr4*.sh

# --- fastsimkit on a Slurm cluster (crvfastsim.kit_uva) and cluster job scripts
export FASTSIMKIT_SCRATCH=/path/to/cluster/working/area # working area on the Slurm cluster
export FASTSIMKIT_FNAL_HOST=your.fnal.interactive.host  # FNAL host the kit streams inputs from (ssh alias)
export FASTSIMKIT_SLURM_HOST=your.slurm.login.host     # ssh host of the Slurm cluster (core Slurm endpoint)
export FASTSIMKIT_SLURM_ACCOUNT=YOUR_SLURM_ACCOUNT     # its Slurm account (core Slurm endpoint)
# export FASTSIMKIT_CRV_DATA=/path/to/crv_fastsim       # default mu2efastsim.site.crv_data()
# export FASTSIMKIT_CRV_CODE=/path/to/code/snapshot     # default $FASTSIMKIT_SCRATCH/crv_response_code_kit
# export FASTSIMKIT_EAF_SHARED_PREFIX=/path/to/storage/shared/by/eaf/and/fnal   # EAF endpoint (scripts/live_kit_crv_response.py)
export SBATCH_ACCOUNT=$FASTSIMKIT_SLURM_ACCOUNT         # read by sbatch for the scripts/*.sh job scripts

# --- ALCF
export ALCF_PROJECT=YOUR_ALCF_PROJECT                   # ALCF allocation (qsub -A)
export M2FS_FLARE=/path/to/your/flare/project/area      # mu2efastsim area on Aurora Flare (offline_data/, venv/)

# --- art and Offline builds
export CRVFS_FCL_PATH=/path/to/fcl/dirs                 # extra FHICL_FILE_PATH for art/dump_crvreco_ref.sh (data unpack fcl)
export CRVFS_SEARCH_PATH=/path/to/payload/root          # extra MU2E_SEARCH_PATH for the payloads that unpack fcl names
export CRVFS_STOCK_AREA=/path/to/built/muse/area        # Offline build with libmu2e_CRVReco.so, for crvfastsim.reco vr2stock
