# CRY primaries only for the fast sim, run2 CRV configuration: gen_only_extracted.fcl with the stock run2 cosmic geometry
# (grid/fcl/geom_cosmic_run2_v10.txt: geom_run2.txt, crv_counters_v10) and the default CRY configuration of the Run 1A / Run 2 cosmic S1 jobs
# (Cosmic.generateCRY: defaultCRYconfig.txt, target box z -5..21 m around the DS; the extracted box misses this CRV).
#include "gen_only_extracted.fcl"
physics.producers.generate.inputFile : "Offline/EventGenerator/defaultConfigs/defaultCRYconfig.txt"
services.GeometryService.inputFile : "geom_cosmic_run2_v10.txt"
physics.producers.g4run.physics.minRangeRegionCuts : { }
outputs.GenOutput.fileName : "gen.owner.CosmicCRYrun2Gen.version.sequencer.art"
