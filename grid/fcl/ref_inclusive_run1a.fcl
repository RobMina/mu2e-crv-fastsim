# Replay retained generator primaries without detector selection or generator time-offset regeneration.
#include "ref_sim_run1a.fcl"
process_name : R3Inclusive
source : { module_type : RootInput }
physics.producers.g4run.inputs.primaryType : "GenParticles"
physics.producers.g4run.inputs.primaryTag : "cosmicTimeOffset::Primary"
physics.PrimaryPath : [ g4run, CrvSteps ]
physics.trigger_paths : [ PrimaryPath ]
physics.EndPath : [ InclusiveOutput ]
physics.end_paths : [ EndPath ]
outputs : {
  InclusiveOutput : {
    module_type : RootOutput
    fileName : "inclusive-run1a.art"
    outputCommands : [ "drop *_*_*_*",
      "keep mu2e::GenParticles_cosmicTimeOffset__Primary",
      "keep mu2e::CosmicLivetime_*_*_*",
      "keep mu2e::GenEventCount_*_*_*",
      "keep mu2e::SimParticlemv_g4run__R3Inclusive",
      "keep mu2e::StatusG4_g4run__R3Inclusive",
      "keep mu2e::StepPointMCs_g4run_CRV_R3Inclusive",
      "keep mu2e::CrvSteps_CrvSteps__R3Inclusive",
      "keep art::TriggerResults_*_*_R3Inclusive" ]
  }
}
