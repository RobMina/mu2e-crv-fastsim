# Read persisted product provenance without detector transport or reconstruction.
#include "Offline/fcl/minimalMessageService.fcl"
process_name : inventory
source : { module_type : RootInput }
services : { message : @local::default_message }
outputs : { productList : { module_type : DataProductDump wantResolvedOnly : true } }
physics : {
  inspect : [ productList ]
  end_paths : [ inspect ]
}
