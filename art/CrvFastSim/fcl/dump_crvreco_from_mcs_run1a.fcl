# Stock Run 1A CRV products and conditions of an MDC2025au mcs file (no re-reco): SelectReco digis, pulses and
# clusters, plus CRVCalib/CRVStatus/CRVOrdinal of Sim_best v1_3 on the Run 1A geometry the production used
# (geom_common.txt -> geom_run1_a_stickman.txt in Offline v13_33_00). Conditions table for crvfastsim.veto.fastframes.
# Usage: mu2e -c CrvFastSim/fcl/dump_crvreco_from_mcs_run1a.fcl -s mcs.mu2e.CeMLeadingLogMix1BB.MDC2025au_best_v1_1.<...>.art -n 10
#include "Offline/fcl/minimalMessageService.fcl"
#include "Offline/fcl/standardServices.fcl"
process_name : crvrecodump
source : { module_type : RootInput }
services : @local::Services.Reco
services.TFileService.fileName : "crvreco_mcs.root"
services.GeometryService.inputFile : "Offline/Mu2eG4/geom/geom_run1_a_stickman.txt"
services.DbService.purpose : Sim_best
services.DbService.version : v1_3
services.DbService.verbose : 0
physics : {
  analyzers : { crvdump : { module_type : CrvRecoTableDumper mc : false digis : "SelectReco" pulses : "SelectReco"
                            clusters : "SelectReco:CrvCoincidenceClusterFinder" } }
  e1 : [ crvdump ]
  end_paths : [ e1 ]
}
