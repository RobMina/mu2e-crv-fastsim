    'mu2e_RecoDataProducts',
    'mu2e_DataProducts',
    'mu2e_CRVConditions',
    'mu2e_ProditionsService',
    'mu2e_DbTables',
    'art_Framework_Core',
    'art_Framework_Principal',
    'art_Framework_Services_Registry',
    'art_root_io_tfile_support',
    'art_root_io_TFileService',
    'art_Persistency_Common',
    'art_Persistency_Provenance',
    'art_Utilities',
    'canvas',
    'MF_MessageLogger',
    'fhiclcpp',
    'fhiclcpp_types',
    'cetlib',
    'cetlib_except',
    'CLHEP',
    rootlibs,
])
